{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Valora3D web app on Cloudflare Workers via the OpenNext adapter.
  // Private preview: Cloudflare Access (Zero Trust) sits in front of both hostnames.
  "name": "valora3d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "valora3d.com", "custom_domain": true },
    { "pattern": "www.valora3d.com", "custom_domain": true }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Valora3D web app on Cloudflare Workers via the OpenNext adapter.
  // Private preview: Cloudflare Access (Zero Trust) sits in front of both hostnames.
  "name": "valora3d",
  // custom-worker.mjs wraps .open-next/worker.js and adds the cron handler below.
  "main": "custom-worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Every 5 min: render sweeper (re-polls RunPod for jobs whose webhook never arrived, app/api/renders/sweep) then
  // owner alerts (app/api/ops/alerts). Daily 07:00 UTC: the owner digest (app/api/ops/digest; DAILY_CRON in
  // custom-worker.mjs must match).
  "triggers": { "crons": ["*/5 * * * *", "0 7 * * *"] },
  "observability": { "enabled": true },
  "ratelimits": [{
    "name": "HYGIENE_RATE_LIMITER",
    "namespace_id": "1003",
    "simple": { "limit": 10, "period": 60 }
  }],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "valora3d.com", "custom_domain": true },
    { "pattern": "www.valora3d.com", "custom_domain": true }
  ]
}

# Copy to .env.local (next dev) or .env.production.local (cf:build). Never commit real values.
# Without the two NEXT_PUBLIC_SUPABASE_* values the app runs on the in-browser fakes.
# NEXT_PUBLIC_* are inlined into the browser bundle AT BUILD TIME: set them before `npm run cf:build`.

# Supabase project (Dashboard > Project Settings > API). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (read at request time). In production set them with `wrangler secret put <NAME>`.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3 API token scoped to the one bucket: Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=valora3d-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Paddle Billing (merchant of record). Sandbox first: sandbox and live have separate accounts,
# keys, prices and webhook secrets. Checkout stays closed until the client token is set.
# NEXT_PUBLIC_* are inlined AT BUILD TIME.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle > Developer tools > Authentication > Client-side tokens (starts test_ in sandbox, live_ in production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Server-only (read at request time; production: `wrangler secret put <NAME>`).
# Paddle > Developer tools > Authentication > API keys. Needs: customer portal sessions (write),
# subscriptions (read/write). Used for Manage billing, plan changes and cancel-on-account-delete.
PADDLE_API_KEY=
# Paddle > Developer tools > Notifications > (your destination) > Secret key. Verifies webhooks only.
PADDLE_WEBHOOK_SECRET=
# Signs the user id sent through checkout (custom_data.user_sig), so nobody can credit, or charge back
# against, another account. Its own random key (`openssl rand -hex 32`), NOT the webhook secret, so rotating
# the webhook secret never strands a paid checkout. Unset = legacy: the webhook secret signs (set it before launch).
CHECKOUT_SIGNING_SECRET=
# Rotation window only: the key being replaced. It keeps verifying (never signs) so checkouts opened before
# the switch still credit when Paddle delivers or retries (up to ~3 days). Remove it after 7 days.
# Moving off the legacy fallback: CHECKOUT_SIGNING_SECRET=<new>, CHECKOUT_SIGNING_SECRET_PREVIOUS=<PADDLE_WEBHOOK_SECRET>.
CHECKOUT_SIGNING_SECRET_PREVIOUS=
# Comma-separated price ids whose $0 transactions (a 100% discount code) still grant credits / a plan.
# Empty (default) = a transaction nobody paid for grants nothing. Restrict gift codes to these prices in Paddle.
PADDLE_PROMO_PRICE_IDS=
# Paddle price ids (pri_...). An empty one means that item is not on sale.
PADDLE_PRICE_CREATOR_MONTHLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PACK_250=
PADDLE_PRICE_PACK_600=
PADDLE_PRICE_PACK_1500=

# Renders (Lane D2). Server-only, read at request time. Without BOTH RunPod values /api/renders answers
# `not_connected` and the studio shows "Rendering is currently unavailable" (no credits move).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# "Render ready" email through Resend. Without RESEND_API_KEY no mail is sent (a no-op).
RESEND_API_KEY=
RENDER_EMAIL_FROM=Valora3D <renders@valora3d.com>
# Lifecycle + billing mail (welcome, tips, expiry warnings, payment problems). README "Lifecycle email".
LIFECYCLE_EMAIL_FROM=Valora3D <hello@valora3d.com>
# One-click unsubscribe token key (32+ chars). Unset => derived from the service-role key.
EMAIL_UNSUBSCRIBE_SECRET=
# Resend webhook signing secret (whsec_...), for bounces/complaints. Unset => /api/resend/webhook is closed.
RESEND_WEBHOOK_SECRET=
# Shared secret (>= 32 chars) the Worker's cron trigger sends to POST /api/renders/sweep. Unset => sweep closed.
CRON_SECRET=
# Owner alerts + daily digest (needs RESEND_API_KEY too). Unset => no owner mail.
OWNER_ALERT_EMAIL=
# Per-job cost estimate shown in /admin (render_jobs.cost_usd_estimate). Unset => no cost stored.
# RunPod RTX 4090 serverless was $1.10/h = 0.000306 per second (2026-09-28); use your console's real rate.
GPU_USD_PER_SECOND=
# Optional: director token prices per million tokens (only used when the worker reports token usage).
DIRECTOR_USD_PER_MTOK_INPUT=
DIRECTOR_USD_PER_MTOK_OUTPUT=
# Build id carried by error reports and logs. Defaults to the git short hash at build time.
NEXT_PUBLIC_RELEASE_ID=

# Launch hygiene. Public values must also be set AT BUILD TIME.
# Turnstile site key (public). Its SECRET key goes in the Supabase dashboard, never here:
# Authentication -> Attack Protection -> CAPTCHA (see README). Empty = no widget (local mode).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional, cookieless Cloudflare Web Analytics (public beacon token).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

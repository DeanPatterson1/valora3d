# Copy to .dev.vars for `npm run cf:preview` / `wrangler dev`. Never commit real values.
# Production: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY` (and each R2_* secret).
# The NEXT_PUBLIC_* pair must ALSO be present at build time (see .env.example).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=valora3d-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RESEND_API_KEY=
RENDER_EMAIL_FROM=Valora3D <renders@valora3d.com>
CRON_SECRET=

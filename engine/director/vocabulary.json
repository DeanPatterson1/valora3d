  "grade.night": {"phrases": ["night", "dark", "moody", "noir"], "except": ["dark[- ](?:blue|red|green|grey|gray|brown|purple|navy|silver|wood|chocolate)"], "note": "A night look isn't available."},
  "grade.warm": {"phrases": ["warm", "golden", "sunset", "cozy"], "note": "A warm look isn't available."},

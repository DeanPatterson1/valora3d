    "restitution": {"type": "number", "min": 0.2, "max": 0.5, "default": 0.35},
    "timeScale": {"type": "number", "min": 0.3, "max": 1.0, "default": 0.5},
    "startS": {"type": "number", "min": 0.0, "max": 8.0, "default": 0.3},
    "tiltDeg": {"type": "number", "min": 0.0, "max": 12.0, "default": 4.0}
